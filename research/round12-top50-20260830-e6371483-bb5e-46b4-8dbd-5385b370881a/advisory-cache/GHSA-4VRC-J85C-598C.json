{"ghsa_id":"GHSA-4vrc-j85c-598c","cve_id":"CVE-2026-22754","url":"https://api.github.com/advisories/GHSA-4vrc-j85c-598c","html_url":"https://github.com/advisories/GHSA-4vrc-j85c-598c","summary":"Spring Security Doesn't Correctly Include Servlet Path in Path Matching of XML Authorization Rules","description":"Vulnerability in Spring Spring Security. If an application uses <sec:intercept-url servlet-path=\"/servlet-path\" pattern=\"/endpoint/**\"/> to define the servlet path for computing a path matcher, then the servlet path is not included and the related authorization rules are not exercised. This can lead to an authorization bypass. This issue affects Spring Security: from 7.0.0 through 7.0.4.","type":"reviewed","severity":"high","repository_advisory_url":null,"source_code_location":"https://github.com/spring-projects/spring-security","identifiers":[{"value":"GHSA-4vrc-j85c-598c","type":"GHSA"},{"value":"CVE-2026-22754","type":"CVE"}],"references":["https://nvd.nist.gov/vuln/detail/CVE-2026-22754","https://spring.io/security/cve-2026-22754","https://github.com/advisories/GHSA-4vrc-j85c-598c"],"published_at":"2026-04-22T06:30:29Z","updated_at":"2026-04-29T20:50:05Z","github_reviewed_at":"2026-04-29T20:50:05Z","nvd_published_at":"2026-04-22T06:16:04Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"maven","name":"org.springframework.security:spring-security-config"},"vulnerable_version_range":">= 7.0.0, <= 7.0.4","first_patched_version":"7.0.5","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:H/A:N","score":7.5},"cvss_v4":{"vector_string":null,"score":0.0}},"cwes":[{"cwe_id":"CWE-284","name":"Improper Access Control"}],"credits":[],"cvss":{"vector_string":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:H/A:N","score":7.5},"epss":{"percentage":0.00266,"percentile":0.18291}}