+          <td>
+            <span
+              @click="goToNamespace(item.tenant_id)"
+              @keypress.enter="goToNamespace(item.tenant_id)"
+              tabindex="0"
+              class="hover"
+            >
+              {{ item.namespace }}
+            </span>
+          </td>
+          <td>
+            <div v-if="item.tags[0]">
+              <v-tooltip
+                v-for="(tag, index) in item.tags"
