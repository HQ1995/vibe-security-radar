+                :disabled="!editDataStatus"
+                :readonly="!editDataStatus"
+                density="compact"
+                :variant="editDataStatus ? 'outlined' : 'plain'"
+                required
+                :hide-details="!emailError"
+                data-test="email-input"
+              />
+            </template>
