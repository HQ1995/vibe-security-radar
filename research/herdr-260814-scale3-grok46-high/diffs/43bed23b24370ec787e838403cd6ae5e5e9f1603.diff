+    await tagsStore.removeTag({
+      tenant: tenant.value,
+      currentName: props.tagName,
+    });
+    snackbar.showSuccess(`${props.tagName} was removed successfully.`);
+    update();
+  } catch (error: unknown) {
+    snackbar.showError("Failed to remove tag.");
+    handleError(error);
