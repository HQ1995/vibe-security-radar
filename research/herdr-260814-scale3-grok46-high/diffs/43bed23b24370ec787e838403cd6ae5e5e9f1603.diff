+  configuration,
+  undefined,
+  newAxiosInstance(),
+);
+const webEndpointsApi = new axiosTs.WebEndpointsApi(
+  configuration,
+  undefined,
+  newAxiosInstance(),
+);
+const billingApi = new axiosTs.BillingApi(
+  configuration,
+  undefined,
+  newAxiosInstance(),
+);
+const rulesApi = new axiosTs.RulesApi(
+  configuration,
+  undefined,
+  newAxiosInstance(),
+);
