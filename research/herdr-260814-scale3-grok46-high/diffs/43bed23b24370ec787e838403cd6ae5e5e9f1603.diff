+<template>
+  <template v-if="onlineDevices.length === 0">
+    <v-card class="bg-v-theme-surface mx-auto py-3 border mt-5" data-test="no-online-devices">
+      <v-card-title class="text-center d-flex justify-center pa-1 mt-5">
