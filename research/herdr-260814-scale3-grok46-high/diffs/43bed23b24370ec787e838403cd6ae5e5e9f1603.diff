+                :class="lgAndUp ? 'w-100' : 'w-75'"
+                prepend-icon="mdi-fingerprint"
+                data-test="mfa-card"
+              >
+                <template #title>
+                  <span class="text-subtitle-1">Multi-factor Authentication</span>
+                </template>
+                <div class="d-flex flex-no-wrap justify-space-between">
