+  } else {
+    validateLength.value = true;
+    errMsg.value = "";
+  }
+});
+
+const toTagNames = (tagsIn: unknown): string[] => {
+  if (!Array.isArray(tagsIn)) return [];
+  return (tagsIn as Array<string | { name?: string }>)
+    .map((t) => (typeof t === "string" ? t : t?.name))
