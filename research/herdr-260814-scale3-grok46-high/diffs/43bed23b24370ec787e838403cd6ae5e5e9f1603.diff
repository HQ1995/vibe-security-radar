+
+				if ns.Settings.ConnectionAnnouncement != "" {
+					return errors.New("unable to unapply the migration")
+				}
+
+				return nil
+			},
+		},
+	}
+
+	for _, test := range cases {
+		tc := test
+		t.Run(tc.description, func(t *testing.T) {
+			tc.requireMocks()
+
