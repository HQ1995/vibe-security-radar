+import useAuthStore from "@/store/modules/auth";
+
+const authStore = useAuthStore();
+const router = useRouter();
+const verificationCode = ref("");
+const showAlert = ref(false);
+const alertMessage = ref("");
+
+const loginMfa = async () => {
+  try {
