+            @update="refreshDevices"
+            data-test="tag-form-update-component"
+          />
+
+          <DeviceDelete
+            variant="device"
+            :has-authorization="true"
+            :redirect="true"
+            :uid="device.uid"
+            @update="refreshDevices"
+            data-test="device-delete-component"
+          />
