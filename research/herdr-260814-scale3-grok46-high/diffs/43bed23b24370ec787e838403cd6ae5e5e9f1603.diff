+
+func TestGetID(t *testing.T) {
+	type Expected struct {
+		id string
+		ok bool
+	}
+	cases := []struct {
+		description string
+		headers     map[string]string
+		expected    Expected
+	}{
+		{
+			description: "verify if given value returns from header",
+			headers: map[string]string{
