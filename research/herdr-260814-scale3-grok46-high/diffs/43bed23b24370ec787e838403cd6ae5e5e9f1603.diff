+
+describe("Users", () => {
+  const pinia = createPinia();
+  setActivePinia(pinia);
+  const usersStore = useUsersStore();
+  usersStore.fetchUsersList = vi.fn();
+
+  const vuetify = createVuetify();
+
+  const wrapper = mount(Users, {
+    global: {
+      plugins: [pinia, vuetify, routes, SnackbarPlugin],
+    },
