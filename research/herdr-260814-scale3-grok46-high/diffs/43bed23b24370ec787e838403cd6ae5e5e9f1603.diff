+      variant="outlined"
+      color="primary"
+      single-line
+      hide-details
+      v-model.trim="filter"
+      @keyup="searchWebEndpoints"
+      prepend-inner-icon="mdi-magnify"
+      density="compact"
+      data-test="search-text"
+    />
