+  cursor: pointer;
+  animation: fadeIn 0.5s;
+}
+
+.hover-text:hover,
+.hover-text:focus {
+  text-decoration: underline;
+}
+
+.link {
+  text-decoration: underline;
+  cursor: pointer;
+}
+</style>
