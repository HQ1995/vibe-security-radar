+
+const fetchDevices = async () => {
+  try {
+    loading.value = true;
+    await devicesStore.fetchDeviceList({
+      perPage: itemsPerPage.value,
+      page: page.value,
+      sortField: sortField.value,
+      sortOrder: sortOrder.value,
+    });
+  } catch (error) {
+    handleError(error);
+    snackbar.showError("Failed to fetch devices.");
+  } finally {
+    loading.value = false;
