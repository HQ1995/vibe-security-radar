+
+watch([tagChoices, choiceFilter], ([list, filterMode]) => {
+  if (filterMode !== "tags") {
+    validateLength.value = true;
+    errMsg.value = "";
+    return;
+  }
+  if (list.length > 3) {
+    validateLength.value = false;
