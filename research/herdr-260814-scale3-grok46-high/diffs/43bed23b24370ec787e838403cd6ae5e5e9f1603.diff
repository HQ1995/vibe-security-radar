+<template>
+  <div>
+    <v-list-item
+      @click="showDialog = true"
+      :disabled="!hasAuthorization"
+      data-test="member-edit-btn"
+    >
+      <div class="d-flex align-center">
+        <div class="mr-2"><v-icon icon="mdi-pencil" /></div>
+        <v-list-item-title data-test="member-edit-title">
+          Edit
+        </v-list-item-title>
+      </div>
