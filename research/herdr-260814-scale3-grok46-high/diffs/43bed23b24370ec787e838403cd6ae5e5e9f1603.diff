+              <template #append>
+                <v-text-field
+                  v-model="username"
+                  :error-messages="usernameError"
+                  :disabled="!editDataStatus"
+                  :readonly="!editDataStatus"
+                  density="compact"
+                  :variant="editDataStatus ? 'outlined' : 'plain'"
