+		ID: user2ID.String(),
+	}
+
+	namespace1 := &models.Namespace{
+		Name:  "namespace1",
+		Owner: user1ID.String(),
+		Billing: &models.Billing{
+			Active: true,
+		},
+	}
+	namespace2 := &models.Namespace{
+		Name:  "namespace2",
+		Owner: user1ID.String(),
+	}
+	namespace3 := &models.Namespace{
+		Name:  "namespace3",
+		Owner: user2ID.String(),
+	}
+
+	cases := []struct {
+		description string
+		before      func()
+		test        func() (int, error)
+		expected    int
+		after       func()
+	}{
+		{
+			"Success to apply up on migration 50 when it is a ShellHub Cloud instance",
+			func() {
+				_, err := c.Database("test").Collection("users").InsertOne(context.TODO(), user1)
