+                <template #activator="{ props }">
+                  <v-chip size="small" v-bind="props">
+                    {{ displayOnlyTenCharacters(tag.name) }}
+                  </v-chip>
+                </template>
+
+                <span>
+                  {{ tag.name }}
+                </span>
