+            </div>
+          </td>
+          <td>
+            {{ formatFullDateTime(item.last_seen) }}
+          </td>
+          <td>
+            <v-chip size="small">
+              {{ item.status }}
+            </v-chip>
+          </td>
+          <td>
+            <v-tooltip bottom anchor="bottom">
+              <template v-slot:activator="{ props }">
+                <v-icon
+                  tag="a"
+                  dark
+                  v-bind="props"
+                  @click="redirectToDevice(item.uid)"
+                  @keypress.enter="redirectToDevice(item.uid)"
