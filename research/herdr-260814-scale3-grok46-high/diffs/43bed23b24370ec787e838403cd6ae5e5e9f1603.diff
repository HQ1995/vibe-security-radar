+
+    <FormDialog
+      v-model="showDialog"
+      @close="close"
+      @confirm="editMember"
+      @cancel="close"
+      title="Update member role"
+      icon="mdi-account-edit"
+      confirm-text="Edit"
+      :confirm-loading="isLoading"
+      cancel-text="Close"
+      confirm-data-test="edit-btn"
+      cancel-data-test="close-btn"
+      data-test="member-edit-dialog"
+    >
+      <v-card-text class="pa-6">
+        <RoleSelect v-model="newRole" />
+      </v-card-text>
+    </FormDialog>
