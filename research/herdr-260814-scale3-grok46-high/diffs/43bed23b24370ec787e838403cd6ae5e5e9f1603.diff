+
+watch(acMenuOpen, async (open) => {
+  if (open && choiceFilter.value === "tags") {
+    await nextTick();
+    setupObserver();
+  } else {
+    cleanupObserver();
+  }
+});
+
+watch(choiceFilter, async (val) => {
+  if (val === "tags") {
