+									CreatedAt: time.Date(2023, 1, 1, 12, 0, 0, 0, time.UTC),
+									UpdatedAt: time.Date(2023, 1, 1, 12, 0, 0, 0, time.UTC),
+									Name:      "production",
+									TenantID:  "00000000-0000-4000-0000-000000000000",
