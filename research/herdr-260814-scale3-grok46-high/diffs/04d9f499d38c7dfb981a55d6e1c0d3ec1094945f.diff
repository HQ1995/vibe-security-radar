+            "filename": "example-1.0.0.tar.gz"
+        },
+    ]
+    assert archive_name(archive_urls) == "example-1.0.0.tar.gz"
+
+
+def test_archive_name_no_sdist():
+    archive_urls = [
+        {
+            "packagetype": "bdist_wheel",
