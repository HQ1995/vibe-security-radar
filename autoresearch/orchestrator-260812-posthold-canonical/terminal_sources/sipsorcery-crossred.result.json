  "mechanism": {
    "entry": "one unauthenticated UDP datagram to the enabled TURN UDP listener",
    "trigger": "a non-ChannelData first byte in 0x80-0xff, for example 80 00 00 00",
    "path": [
      "TurnServer.Start fire-and-forgets ReceiveUdpAsync without supervision",
      "ReceiveUdpAsync receives inside while",
      "HandleUdpDatagram executes outside the per-receive try",
      "STUNMessage.ParseSTUNMessage calls STUNHeader.ParseSTUNHeader",
      "STUNHeader.ParseSTUNHeader throws ApplicationException on the malformed first byte",
      "the exception reaches catch(Exception) outside while",
      "ReceiveUdpAsync returns while _running remains true and is not restarted"
    ],
    "impact": "whole TurnServer UDP relay remains unavailable to all clients until process restart",
    "pre_authentication": true,
    "but_for": {
      "result": "PASS",
      "counterfactual": "At parent 781c6b8e the TurnServer.cs path and TurnServer component do not exist; removing minimum member 6edd60f5 removes Start, ReceiveUdpAsync, HandleUdpDatagram, and the complete advisory mechanism.",
      "alternate_parent_path": false
    }
  },
