{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "python3 ../scripts/publish_research_ledger.py",
    "dev": "next dev",
    "prebuild": "python3 ../scripts/publish_research_ledger.py && node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "build": "next build",
    "postbuild": "npm run research:data:check",
    "start": "next start",
    "research:data": "python3 ../scripts/publish_research_ledger.py",
    "research:data:check": "vitest run src/lib/__tests__/research-data.test.ts src/lib/__tests__/research-status.test.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.2.10",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "7.3.6",
    "postcss": "8.5.19"
  }
}
