{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "prebuild": "python3 ../scripts/site_preflight.py && node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "verify:live": "python3 ../scripts/site_preflight.py --verify-fix-objects-live && python3 ../scripts/check_advisory_links.py",
    "build": "next build",
    "postbuild": "PYTHONPATH=../scripts python3 ../scripts/tests/test_site_publication_contract.py && npm test",
    "start": "npx --yes serve out -l 3000",
    "research:data:sync": "python3 ../scripts/ledger_store.py export && python3 ../scripts/audit_envelope.py && python3 ../scripts/publish_tp_ledger.py --prefer-export",
    "research:data:check": "vitest run src/lib/__tests__/research-data.test.ts",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.2.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "7.3.6",
    "postcss": "8.5.19"
  }
}
