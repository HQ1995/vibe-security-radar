{
  "schema_version": 1,
  "cause_categories": {
    "path_link": {
      "label": "Path & link handling",
      "definition": "Unsafe path construction, filesystem scope checks, archive extraction, local file access, or symbolic-link handling."
    },
    "injection": {
      "label": "Injection & unsafe execution",
      "definition": "Untrusted data reaches command, shell, template, script, query, spreadsheet, HTML, or similar execution contexts without safe encoding or isolation."
    },
    "auth_access": {
      "label": "Authentication & access control",
      "definition": "Missing, bypassed, or confused authentication, authorization, identity, ownership, tenant, or privilege boundaries."
    },
    "ssrf_network": {
      "label": "SSRF & network boundaries",
      "definition": "Unsafe URL parsing, redirects, proxying, credential forwarding, or destination checks allow unintended network access or trust-boundary crossing."
    },
    "validation_fail_open": {
      "label": "Validation & fail-open logic",
      "definition": "A security validator, denylist, signature, or schema check is incomplete, incorrectly ordered, or allows processing after validation cannot be established."
    },
    "resource_abuse": {
      "label": "Resource abuse & availability",
      "definition": "Unbounded input, computation, memory, storage, retry, rate, or loop behavior enables denial of service or disproportionate resource use."
    },
    "other_ambiguous": {
      "label": "Other / insufficient public mechanism detail",
      "definition": "The canonical mechanism fields do not expose enough stable public detail for a more specific cause category."
    }
  },
